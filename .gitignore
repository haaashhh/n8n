# Secrets — never commit
.env
.env.*
!.env.example

# Backups / dumps
n8n-backups/
*.sql
*.sql.gz
*.dump
*.tar.gz

# SearXNG instance secret (commit searxng/settings.yml.example instead)
searxng/settings.yml

# macOS / editor cruft
.DS_Store
*.log

# Client data — confidential; repo is public. Commit only the template + structure.
clients/*
!clients/README.md
!clients/_registry.example.json
!clients/_TEMPLATE/
!clients/_TEMPLATE/**
