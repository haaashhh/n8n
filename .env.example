# Copy to .env and fill in. Generate each secret with: openssl rand -hex 32
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=n8n

# CRITICAL: generate once and NEVER change after first run, or all saved
# credentials become permanently undecryptable. Back this up off-machine.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

GENERIC_TIMEZONE=Europe/Berlin
